<screen>
    <view width="320" height="170" style_bg_color="0x111111">
        <lv_obj name="panel_left"
                x="0"
                y="0"
                width="160"
                height="170"
                style_bg_color="0x1A1A2E"
                style_pad_all="6">
            <lv_label name="left_title"
                      x="56"
                      y="10"
                      text="CONTROL"
                      style_text_color="0xA5B4FC"/>

            <button_primary name="btn_mode_up" x="10" y="28" text="MODE UP"/>
            <button_primary name="btn_mode_down" x="84" y="28" text="MODE DOWN"/>

            <button_primary name="btn_color_up" x="10" y="56" text="COLOR UP"/>
            <button_primary name="btn_color_down" x="84" y="56" text="COLOR DOWN"/>

            <button_arrow name="btn_prev" x="10" y="88" text="&lt;"/>
            <lv_label name="lbl_selection"
                      x="40"
                      y="90"
                      width="80"
                      text="Mode: Pure Reactive\nColor: #FFFFFF"
                      style_text_color="0xE5E7EB"/>
            <button_arrow name="btn_next" x="126" y="88" text="&gt;"/>

            <button_set name="btn_set" x="10" y="136" text="SET"/>
        </lv_obj>

        <lv_obj name="panel_right"
                x="160"
                y="0"
                width="160"
                height="170"
                style_bg_color="0x0D0D1A"
                style_pad_all="4">
            <lv_label name="right_title"
                      x="34"
                      y="10"
                      text="DRUM MONITOR"
                      style_text_color="0x88CCAA"/>

            <lv_button name="node_snare" x="6" y="28" width="70" height="42">
                <lv_label text="SNARE"/>
            </lv_button>

            <lv_button name="node_ttom" x="84" y="28" width="70" height="42">
                <lv_label text="T.TOM"/>
            </lv_button>

            <lv_button name="node_ftom" x="6" y="76" width="70" height="42">
                <lv_label text="F.TOM"/>
            </lv_button>

            <lv_button name="node_kick" x="84" y="76" width="70" height="42">
                <lv_label text="KICK"/>
            </lv_button>

            <lv_label name="lbl_node_info"
                      x="10"
                      y="146"
                      width="144"
                      text="Selected drum: SNARE"
                      style_text_color="0xCBD5E1"/>
        </lv_obj>
    </view>
</screen>
