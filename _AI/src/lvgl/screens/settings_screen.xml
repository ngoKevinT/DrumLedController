<screen>
    <view width="320" height="170" style_bg_color="0x101827">
        <lv_label name="title"
              x="8"
              y="8"
              text="SETTINGS"
              style_text_color="0xD1FAE5"/>

        <lv_button name="btn_back" x="226" y="8" width="86" height="22">
            <lv_label text="Back"/>
        </lv_button>

        <lv_label name="lbl_connected"
              x="8"
              y="32"
              text="Connected nodes: 0 / 4"
              style_text_color="0xA7F3D0"/>

        <lv_label name="lbl_global_title"
              x="8"
              y="52"
              text="Global Defaults"
              style_text_color="0xBFDBFE"/>

        <lv_label name="lbl_sensitivity"
              x="8"
              y="72"
              text="Sensitivity"
              style_text_color="0xE5E7EB"/>
        <lv_slider name="slider_sensitivity" x="96" y="74" width="138" height="10" min_value="0" max_value="255" value="128"/>

        <lv_label name="lbl_retrigger"
              x="8"
              y="92"
              text="Retrigger ms"
              style_text_color="0xE5E7EB"/>
        <lv_slider name="slider_retrigger" x="96" y="94" width="138" height="10" min_value="1" max_value="120" value="30"/>

        <lv_label name="lbl_node_title"
              x="8"
              y="114"
              text="Connected Drum Node Settings"
              style_text_color="0xFDE68A"/>

        <lv_button name="btn_node_prev" x="8" y="134" width="22" height="18">
            <lv_label text="&lt;"/>
        </lv_button>

        <lv_label name="lbl_node_name"
              x="38"
              y="137"
              text="Node: SNARE"
              style_text_color="0xFEF3C7"/>

        <lv_button name="btn_node_next" x="154" y="134" width="22" height="18">
            <lv_label text="&gt;"/>
        </lv_button>

        <lv_label name="lbl_node_mode"
              x="8"
              y="154"
              text="Mode: Pure Reactive"
              style_text_color="0xE5E7EB"/>

        <lv_label name="lbl_node_color"
              x="166"
              y="154"
              text="Color: #FFFFFF"
              style_text_color="0xE5E7EB"/>
    </view>
</screen>
