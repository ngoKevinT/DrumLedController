<component>
    <api>
        <prop name="text" type="string" default="SET"/>
        <prop name="width" type="int" default="140"/>
        <prop name="height" type="int" default="24"/>
    </api>

    <view extends="lv_button"
          width="$width"
          height="$height"
          style_bg_color="0x005599"
          style_radius="4">
        <lv_label text="$text" style_text_color="0xFFFFFF"/>
    </view>
</component>
