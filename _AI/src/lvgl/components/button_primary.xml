<component>
    <api>
        <prop name="text" type="string" default="BUTTON"/>
        <prop name="width" type="int" default="66"/>
        <prop name="height" type="int" default="22"/>
    </api>

    <view extends="lv_button"
          width="$width"
          height="$height"
          style_bg_color="0x334155"
          style_radius="4">
        <lv_label text="$text" style_text_color="0xE5E7EB"/>
    </view>
</component>
