<component>
    <api>
        <prop name="text" type="string" default="&gt;"/>
        <prop name="width" type="int" default="24"/>
        <prop name="height" type="int" default="24"/>
    </api>

    <view extends="lv_button"
          width="$width"
          height="$height"
          style_bg_color="0x475569"
          style_radius="3">
        <lv_label text="$text" style_text_color="0xF8FAFC"/>
    </view>
</component>
